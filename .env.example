DATABASE_URL="postgresql://user:password@localhost:5432/bee2?schema=public"
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_SETUP_TOKEN="generate-a-long-random-string"

# Optional: online payments (Stripe). Leave unset to keep /acheter and
# the checkout/webhook routes dormant (they return a clean "not
# configured" response instead of an error) — nothing else in the app
# depends on these being set.
# STRIPE_SECRET_KEY="sk_live_or_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."          # from `stripe listen` or the Stripe dashboard
# STRIPE_CURRENCY="usd"                       # any Stripe-supported currency code, lowercase
# STRIPE_PRICE_ANNUAL_CENTS="2000"            # e.g. 2000 = 20.00 in the currency above
# STRIPE_PRICE_LIFETIME_CENTS="8000"
