generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth & licensing ----------

enum Role {
  TEACHER
  ADMIN
}

enum LicenseType {
  TRIAL
  ANNUAL
  LIFETIME
}

enum LicenseStatus {
  UNUSED
  ACTIVE
  REVOKED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role     @default(TEACHER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  licenseKey  LicenseKey?
  activations Activation[]
  texts       Text[]
  lessonPlans LessonPlan[]
}

model LicenseKey {
  id             String        @id @default(cuid())
  code           String        @unique
  type           LicenseType   @default(ANNUAL)
  status         LicenseStatus @default(UNUSED)
  maxActivations Int           @default(2)
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  activatedAt    DateTime?
  revokedAt      DateTime?
  notes          String?

  // Set when this key was generated by a paid Stripe Checkout session
  // rather than seeded/admin-created. Unique so the webhook (which can
  // retry on non-2xx responses) and the success page (which fulfils as a
  // fallback in case the webhook hasn't landed yet) can never create two
  // keys for the same purchase.
  stripeCheckoutSessionId String? @unique

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  activations Activation[]

  @@index([status])
}

model Activation {
  id                String     @id @default(cuid())
  licenseKeyId      String
  licenseKey        LicenseKey @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String
  deviceLabel       String?
  ipAddress         String?
  userAgent         String?
  firstSeenAt       DateTime   @default(now())
  lastSeenAt        DateTime   @default(now())
  revoked           Boolean    @default(false)

  @@unique([licenseKeyId, deviceFingerprint])
  @@index([userId])
}

// ---------- Content ----------

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum TextSource {
  ORIGINAL
  PUBLIC_DOMAIN
  TEACHER_IMPORT
}

model Text {
  id          String     @id @default(cuid())
  title       String
  level       CefrLevel
  theme       String
  tags        String[]   @default([])
  ageGroup    String?
  wordCount   Int
  source      TextSource @default(ORIGINAL)
  author      String?
  body        String
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  exercises   Exercise[]
  lessonPlans LessonPlan[]

  @@index([level])
  @@index([theme])
}

enum ExerciseType {
  VOCAB_MATCH
  TRUE_FALSE
  COMPREHENSION
  FILL_BLANK
  DISCUSSION
}

model Exercise {
  id     String       @id @default(cuid())
  textId String
  text   Text         @relation(fields: [textId], references: [id], onDelete: Cascade)
  type   ExerciseType
  order  Int          @default(0)
  data   Json

  @@index([textId])
}

// ---------- Official "fiche pédagogique" (APC/PI, Burkina Faso) ----------

enum SchoolClassLevel {
  SIXIEME
  CINQUIEME
  QUATRIEME
  TROISIEME
}

enum SessionType {
  LEARNING
  CONSOLIDATION
  PROBLEM_SOLVING
}

model LessonPlan {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Administrative header (fields teachers fill in on the official form)
  date                     DateTime @default(now())
  teacherName              String
  provincialDirectorate    String?
  school                   String?
  classLabel               String
  boysCount                Int?
  girlsCount               Int?
  attendance               String?
  learnersWithSpecialNeeds String?

  // Curriculum reference (from the official "planification détaillée")
  classLevel   SchoolClassLevel
  unitNumber   String
  unitTitle    String
  lessonNumber String
  lessonTitle  String
  sessionTitle String

  competence           String
  typeOfSession        SessionType
  languageMainSkill    String
  integratedSkills     String?
  lessonContentVocab   String?
  lessonContentGrammar String?
  languageFunctions    String?
  objectives           String[]    @default([])
  methodsTechniques    String?
  teachingAids         String?
  durationMin          Int         @default(55)

  /**
   * Structured phase table matching the official framework for this session type.
   */
  phases Json

  // Consolidation / problem-solving ("situation d'intégration") specifics
  activityContext      String?
  appreciationCriteria String[] @default([])
  expectedProduction   String[] @default([])
  /**
   * Grille de correction critériée (Pertinence, Language Accuracy, Coherence, Refinement).
   */
  markingGrid          Json?

  textId String?
  text   Text?   @relation(fields: [textId], references: [id])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([createdById])
  @@index([classLevel])
}
